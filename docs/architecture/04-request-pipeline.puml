@startuml request-pipeline
!include style.iuml
title Request pipeline (tower layers and axum extractors)

start
:Incoming HTTP request;

partition "Tower layers (outermost first)" {
  :TraceLayer
  span per request, logs response at INFO;
  :CorsLayer
  origins from CORS_ALLOWED_ORIGINS,
  methods GET/POST/PATCH/DELETE,
  headers Authorization, Content-Type;
  :DefaultBodyLimit
  64 KiB (MAX_BODY_BYTES);
}

:Router matches path + method;
if (route found?) then (no)
  :404 / 405 from axum;
  stop
endif

partition "Extractors (handler arguments)" {
  if (protected route?) then (yes: /todos*)
    :AuthUser
    parse "Bearer <jwt>", jwt::verify;
    if (valid?) then (no)
      :AppError::Unauthorized -> 401; <<#FFCDD2>>
      stop
    endif
  endif
  :AppPath<Uuid>
  bad id -> NotFound (404);
  :AppQuery<ListParams>
  bad query -> Validation (422);
  :AppJson<T>
  bad JSON -> Validation (422)
  too large -> PayloadTooLarge (413);
}

:Handler
validate() request model
-> repo function -> PostgreSQL;

if (Ok?) then (yes)
  :200 / 201 / 204 + JSON body; <<#C8E6C9>>
else (no)
  :AppError::into_response
  {"error": "..."}
  5xx details are logged, not returned; <<#FFCDD2>>
endif
stop
@enduml
