  "db_name": "PostgreSQL",
  "query": "\n        UPDATE todos SET\n            title       = COALESCE($3, title),\n            description = CASE WHEN $4 THEN $5 ELSE description END,\n            completed   = COALESCE($6, completed),\n            updated_at  = now()\n        WHERE id = $1 AND user_id = $2\n        RETURNING id, user_id, title, description, completed, created_at, updated_at\n        ",
